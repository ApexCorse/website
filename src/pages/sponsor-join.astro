---
import Footer from "@/components/shared/Footer.astro";
import Header from "@/components/shared/Header.astro";
import SponsorJoinForm from "@/components/sponsors/SponsorJoinForm";
import { INDUSTRIES_IT } from "@/constants/sponsors";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <Header />
  <div
    class="flex min-h-screen w-full flex-col items-center justify-center gap-4 px-4 py-24 md:gap-8 md:py-0"
  >
    <h1 class="font-primary text-4xl text-white uppercase">Unisciti a noi</h1>
    <SponsorJoinForm
      industries={INDUSTRIES_IT}
      fieldLabels={{
        name: "Società",
        industry: "Industria",
        email: "Email",
        address: "Indirizzo",
        city: "Città",
        state: "Stato",
        zipCode: "CAP",
        country: "Provincia",
        reason: "Come puoi collaborare con noi?",
      }}
      locale="it"
      client:load
    />
  </div>
  <Footer />
</Layout>

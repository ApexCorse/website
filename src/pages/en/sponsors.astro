---
import TextDisplay from "@/components/shared/TextDisplay.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "@/components/shared/Footer.astro";
import flag from "@/assets/images/flag.png";

import { cn } from "@/lib/utils/cn";
import Ansys from "@/assets/sponsors/ansys.svg";
import Crg from "@/assets/sponsors/crg.svg";
import Fenice from "@/assets/sponsors/fenice.svg";
import Hexagon from "@/assets/sponsors/hexagon.svg";
import Hypertec from "@/assets/sponsors/hypertec.svg";
import Loctite from "@/assets/sponsors/loctite.svg";
import Nigrelli from "@/assets/sponsors/nigrelli.svg";
import Omhero from "@/assets/sponsors/omhero.svg";
import Pirelli from "@/assets/sponsors/pirelli.svg";
import Qnap from "@/assets/sponsors/qnap.svg";
import Tesla from "@/assets/sponsors/tesla.svg";
import Batemo from "@/assets/sponsors/batemo.svg";

const metadata = {
  title: "Partners • Apex Corse",
  description: "Our partners and sponsors supporting Apex Corse",
};
---

<Layout title={metadata.title} description={metadata.description}>
  <TextDisplay text="Our Partners" image={flag.src} />
  <div class="px-4">
    <div
      class="flex flex-col items-center justify-center gap-12 py-16 text-white sm:gap-16"
    >
      <div class="flex w-full flex-col items-center justify-center gap-8 sm:gap-12">
        <a
          href="https://www.omhero.tech/"
          target="_blank"
          class="max-w-2xl text-gray-300 hover:opacity-80"
        >
          <Omhero />
        </a>
        <div class="flex w-full max-w-5xl flex-wrap items-end justify-center gap-12 sm:gap-16">
          {
            [
              {
                Component: Pirelli,
                href: "https://pirelli.com",
              },
              {
                Component: Nigrelli,
                href: "https://grupponigrelli.it",
              },
              {
                Component: Batemo,
                href: "https://www.batemo.com",
              },
              {
                Component: Tesla,
                href: "https://www.tesla.com",
              },
            ].map(({ Component, href }) => (
              <a
                href={href}
                target="_blank"
                class={cn("max-w-72 flex-1 text-gray-300 hover:opacity-80")}
              >
                <Component class="h-full w-full max-w-72" />
              </a>
            ))
          }
        </div>
        <div
          class="flex w-full max-w-6xl flex-wrap items-center justify-center gap-8 md:gap-12"
        >
          {
            [
              {
                Component: Hexagon,
                href: "https://www.hexagon.com",
              },
              {
                Component: Loctite,
                href: "https://www.loctite.com",
              },

              {
                Component: Qnap,
                href: "https://www.qnap.com",
              },
              {
                Component: Hypertec,
                href: "https://hypertec.it",
              },
              {
                Component: Crg,
                href: "https://kartcrg.com",
              },
              {
                Component: Ansys,
                href: "https://www.ansys.com",
              },
              {
                Component: Fenice,
                href: "https://fenicepalermo.it",
              },
            ].map(({ Component, href }) => (
              <a
                href={href}
                target="_blank"
                class="w-full max-w-28 text-gray-500 hover:opacity-80"
              >
                <Component class="h-full max-h-16 w-full" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <Footer />
  </div>
</Layout>

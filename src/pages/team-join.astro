---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import TeamJoinForm from "@/components/team/TeamJoinForm";
import {
	CAME_ACROSS_BY_IT,
	COURSE_TYPES_IT,
	DEPARTMENT_CHOICE,
	YEARS_IT,
} from "@/constants/team";
import Layout from "@/layouts/Layout.astro";

const applicationsOpen = import.meta.env.APPLICATIONS_OPEN as boolean;
---

<Layout>
	<Header />
	<div
		class="flex min-h-screen w-full flex-col items-center justify-center gap-4 px-4 py-24 md:gap-8 md:py-0"
	>
		{
			applicationsOpen ? (
				<div>
					<h1 class="font-primary text-4xl text-white uppercase">
						Candidati ora
					</h1>
					<TeamJoinForm
						fieldLabels={{
							firstName: "Nome",
							lastName: "Cognome",
							email: "Email istituzionale",
							phoneNumber: "Telefono",
							courseType: "Tipologia di corso",
							course: "Corso",
							year: "Anno",
							cameAcrossBy: "Come ci hai conosciuto?",
							department: "Dipartimento di preferenza",
							cv: "Curriculum",
						}}
						courseTypesList={COURSE_TYPES_IT}
						yearsList={YEARS_IT}
						cameAcrossByList={CAME_ACROSS_BY_IT}
						departmentsList={DEPARTMENT_CHOICE}
						locale="it"
						client:load
					/>
					<Footer />
				</div>
			) : (
				<div class="flex flex-col items-center gap-4">
					<p class="text-xl text-white">
						Candidature non aperte al momento...
					</p>
					<a href="/" class="text-gray-300 underline">
						Torna alla home
					</a>
				</div>
			)
		}
	</div>
</Layout>

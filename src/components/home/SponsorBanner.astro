---
import { bannerSponsors } from "@/data/sponsors";
import SponsorLogo from "@/components/sponsors/SponsorLogo.astro";
---

<section class="w-full overflow-hidden py-8 mask-x-from-50% mask-x-to-100%">
  <div class="sponsor-scroll flex w-max animate-scroll">
    {/* First set of sponsors - Omhero positioned in the middle */}
    {
      bannerSponsors.map((sponsor) => (
        <a
          href={sponsor.href}
          target="_blank"
          class="flex h-24 w-40 items-center justify-center px-4 text-gray-400 transition-opacity hover:opacity-80"
        >
          <SponsorLogo sponsor={sponsor} class="max-h-16 w-full max-w-32" />
        </a>
      ))
    }
    {/* Duplicate for seamless loop */}
    {
      bannerSponsors.map((sponsor) => (
        <a
          href={sponsor.href}
          target="_blank"
          class="flex h-24 w-40 items-center justify-center px-4 text-gray-400 transition-opacity hover:opacity-80"
        >
          <SponsorLogo sponsor={sponsor} class="max-h-16 w-full max-w-32" />
        </a>
      ))
    }
  </div>
</section>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll 40s linear infinite;
  }

  .sponsor-scroll:hover {
    animation-play-state: paused;
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import TextDisplay from "@/components/shared/TextDisplay.astro";
import Footer from "@/components/shared/Footer.astro";
import SponsorsList from "@/components/sponsors/SponsorsList.astro";

import blunda from "@/assets/images/blunda.png"

const metadata = {
  title: "Sponsors • Apex Corse",
  description: "Find out the sponsors supporting Apex Corse",
};
---

<Layout title={metadata.title} description={metadata.description}>
	<TextDisplay text="Sponsors" image={blunda.src} />
	<SponsorsList />
	<Footer />
</Layout>

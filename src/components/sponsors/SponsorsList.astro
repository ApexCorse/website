---
import { sponsors } from "@/data/sponsors";
import SponsorLogo from "@/components/sponsors/SponsorLogo.astro";

const mainSponsors = sponsors.filter((s) => s.tier === "main");

const tierSections = [
  {
    label: "Diamond",
    tier: "diamond" as const,
    minW: "min-w-56",
    maxW: "max-w-56",
    color: "text-gray-300",
  },
  {
    label: "Platinum",
    tier: "platinum" as const,
    minW: "min-w-48",
    maxW: "max-w-48",
    color: "text-gray-300",
  },
  {
    label: "Gold",
    tier: "gold" as const,
    minW: "min-w-40",
    maxW: "max-w-40",
    color: "text-gray-300",
  },
  {
    label: "Silver",
    tier: "silver" as const,
    minW: "min-w-32",
    maxW: "max-w-32",
    color: "text-gray-400",
  },
  {
    label: "Bronze",
    tier: "bronze" as const,
    minW: "min-w-24",
    maxW: "max-w-24",
    color: "text-gray-400",
  },
];
---

<div class="mx-auto flex max-w-[1280px] flex-col gap-16 px-4 py-16 sm:gap-24 sm:py-24">
  <!-- Main Sponsor -->
  <section class="flex flex-col gap-8">
    <div class="flex items-center gap-4">
      <span class="font-primary text-lg uppercase text-gray-500 sm:text-xl">Main Sponsor</span>
      <div class="flex-1 border-t border-gray-500"></div>
    </div>
    <div class="flex justify-center">
      {
        mainSponsors.map((sponsor) => (
          <a
            href={sponsor.href}
            target="_blank"
            class="max-w-lg text-gray-300 transition-opacity hover:opacity-80"
          >
            <SponsorLogo sponsor={sponsor} />
          </a>
        ))
      }
    </div>
  </section>

  <!-- Tiered Sponsors -->
  {
    tierSections.map(({ label, tier, minW, maxW, color }) => {
      const tierSponsors = sponsors.filter((s) => s.tier === tier);
      return (
        <section class="flex flex-col gap-8">
          <div class="flex items-center gap-4">
            <span class="font-primary text-lg uppercase text-gray-500 sm:text-xl">{label}</span>
            <div class="flex-1 border-t border-gray-500" />
          </div>
          <div class="flex flex-wrap justify-center gap-x-8 gap-y-12 sm:gap-x-12 sm:gap-y-16 md:gap-x-20 md:gap-y-24 lg:gap-x-28 lg:gap-y-32">
            {
              tierSponsors.map((sponsor) => (
                <a
                  href={sponsor.href}
                  target="_blank"
                  class={`flex ${minW} items-center justify-center ${color} transition-opacity hover:opacity-80`}
                >
                  <SponsorLogo sponsor={sponsor} class={maxW} />
                </a>
              ))
            }
          </div>
        </section>
      );
    })
  }
</div>

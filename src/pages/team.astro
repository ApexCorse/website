---
import DepartmentSection from "@/components/team/DepartmentSection.astro";
import { getMembers } from "@/lib/utils/members";
import TextDisplay from "@/components/shared/TextDisplay.astro";
import Layout from "../layouts/Layout.astro";

import Footer from "@/components/layout/Footer.astro";
import team from "../assets/images/team.png";

const members = await getMembers();

const boardMembers = members.filter((member) => member.department === "board");
const chassisMembers = members.filter(
  (member) => member.department === "chassis",
);
const aerodynamicsMembers = members.filter(
  (member) => member.department === "aerodynamics",
);
const itMembers = members.filter((member) => member.department === "it");
const powertrainMembers = members.filter(
  (member) => member.department === "powertrain",
);
const graphicsMembers = members.filter(
  (member) => member.department === "graphics",
);
const electronicsMembers = members.filter(
  (member) => member.department === "electronics",
);
const businessAndCostMembers = members.filter(
  (member) => member.department === "business" || member.department === "cost",
);
const logisticsMembers = members.filter(
  (member) => member.department === "logistics",
);
const advisorsMembers = members.filter(
  (member) => member.department === "advisors",
);

const metadata = {
  title: "Team • Apex Corse",
  description: "Scopri il team dietro Apex Corse",
};
---

<Layout title={metadata.title} description={metadata.description}>
  <TextDisplay text="Il Team" image={team.src} />
  <DepartmentSection
    department="board"
    title="Board"
    members={boardMembers}
    description="Composto da giovani studenti pieni di determinazione e passione per l’innovazione, il Board di APEX Corse coordina le attività delle varie divisioni operative e guida la squadra verso il conseguimento degli obiettivi. È composto dal Team Leader, dal Technical Director, dal Managing Director e da tutti i Division Manager."
  />

  <DepartmentSection
    department="chassis"
    title="Chassis"
    members={chassisMembers}
    description="Il Reparto Chassis si occupa della progettazione e realizzazione del corpo della monoposto. Tra i principali compiti rientrano la selezione dei materiali, l’analisi strutturale del telaio e l’ottimizzazione del design, con l’obiettivo di ottenere una soluzione performante e sicura."
  />
  <DepartmentSection
    department="aerodynamics"
    title="Aerodynamics"
    members={aerodynamicsMembers}
    description="Il Reparto Aerodinamica progetta e realizza il pacchetto aerodinamico della vettura, lavorando in sinergia con il Reparto Chassis. Ogni componente viene integrato nel design complessivo della vettura, al fine di ottimizzare l’efficienza dei flussi."
  />
  <DepartmentSection
    department="it"
    title="IT"
    members={itMembers}
    description="Il Reparto IT sviluppa i software per l’acquisizione e l’analisi dei dati, gestisce i sistemi informatici interni e fornisce supporto tecnico alle altre divisioni operative, contribuendo al miglioramento continuo delle prestazioni del team."
  />
  <DepartmentSection
    department="powertrain"
    title="Powertrain"
    members={powertrainMembers}
    description="Il Reparto Powertrain è responsabile dello sviluppo del sistema di propulsione. Progetta, costruisce e ottimizza tutti i componenti fondamentali che costituiscono il cuore della monoposto."
  />
  <DepartmentSection
    department="electronics"
    title="Electronics"
    members={electronicsMembers}
    description="Il Reparto Elettronica cura la progettazione e l’implementazione di tutti i sistemi elettronici della vettura, occupandosi della gestione del sistema elettrico, dell’acquisizione dati e dei dispositivi di controllo e sicurezza."
  />
  <DepartmentSection
    department="graphics"
    title="Graphics & Media"
    members={graphicsMembers}
    description="Il Reparto Graphics & Media si dedica alla gestione dell’identità visiva della squadra. Cura i contenuti digitali, i materiali grafici e la comunicazione sui canali social, raccontando il progetto e valorizzando l’immagine di Apex Corse."
  />
  <DepartmentSection
    department="business"
    title="Business & Cost"
    members={businessAndCostMembers}
    description="Il Reparto Business & Cost si occupa della gestione delle sponsorship e della pianificazione finanziaria. Il suo lavoro garantisce le risorse economiche necessarie per la progettazione e la realizzazione della monoposto."
  />
  <DepartmentSection
    department="logistics"
    title="Logistics"
    members={logisticsMembers}
    description="Il Reparto Logistica organizza e coordina gli aspetti operativi della squadra assicurando che risorse, materiali e tempistiche siano coordinati in modo efficiente per il successo del progetto."
  />
  <DepartmentSection
    department="advisors"
    title="Advisors"
    members={advisorsMembers}
    description="I Faculty Advisors sono figure accademiche che mettono la loro esperienza a disposizione del team. Pur non facendo parte operativa della squadra, il loro supporto rappresenta una risorsa preziosa per la crescita tecnica e strategica del progetto."
  />
  <Footer />
</Layout>

---
interface Props {
	article: CollectionEntry<"blog" | "blogEn">;
}

import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

const { article } = Astro.props;

let image: Promise<{ default: ImageMetadata }> | undefined;

if (article.data.image) {
	image = import(`../../assets/blog/${article.data.image}.png`) as Promise<{
		default: ImageMetadata;
	}>;
}

const currentLocale = Astro.currentLocale || "it";
---

<div class="flex flex-col items-center gap-8 md:flex-row">
	<a href={getRelativeLocaleUrl(currentLocale, `blog/${article.id}`)} class="flex-1">
		<Image
			src={image!}
			alt={article.data.title}
			class="aspect-video rounded-3xl object-cover"
		/>
	</a>
	<div class="flex flex-1 flex-col gap-4 py-4 md:gap-6">
		<a href={getRelativeLocaleUrl(currentLocale, `blog/${article.id}`)}>
			<h1
				class="font-primary text-2xl font-medium text-white uppercase md:text-4xl"
			>
				{article.data.title}
			</h1>
		</a>
		{article.data.subtitle && (
			<p class="text-base font-normal text-gray-400 md:text-lg">
				{article.data.subtitle}
			</p>
		)}
		<p class="line-clamp-3 text-gray-300">
			{article.data.author} • {
				article.data.date.toLocaleDateString(
					Astro.currentLocale || "it",
					{
						dateStyle: "long",
					}
				)
			}
		</p>
	</div>
</div>

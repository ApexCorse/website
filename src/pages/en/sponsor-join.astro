---
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SponsorJoinForm from "@/components/sponsors/SponsorJoinForm";
import Layout from "@/layouts/Layout.astro";
import { INDUSTRIES_EN } from "@/constants/sponsors";
---

<Layout>
	<Header />
	<div
		class="flex min-h-screen w-full flex-col items-center justify-center gap-4 md:gap-8 px-4 py-24 md:py-0"
	>
		<h1 class="font-primary text-4xl text-white uppercase">
			Join as a sponsor
		</h1>
		<SponsorJoinForm
			industries={INDUSTRIES_EN}
			fieldLabels={{
				name: "Company Name",
				industry: "Industry",
				email: "Email",
				address: "Address",
				city: "City",
				state: "State",
				zipCode: "Zip Code",
				country: "Country",
				reason: "How can you help us?",
			}}
			locale="en"
			client:load
		/>
	</div>
	<Footer />
</Layout>

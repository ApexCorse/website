---
import DepartmentSection from "@/components/team/DepartmentSection.astro";
import { getMembers } from "@/lib/utils/members";
import TextDisplay from "@/components/shared/TextDisplay.astro";
import Layout from "../../layouts/Layout.astro";

import team from "@/assets/images/team.png";
import Footer from "@/components/shared/Footer.astro";

const members = await getMembers();

const boardMembers = members.filter((member) => member.department === "board");
const chassisMembers = members.filter(
	(member) => member.department === "chassis"
);
const aerodynamicsMembers = members.filter(
	(member) => member.department === "aerodynamics"
);
const itMembers = members.filter((member) => member.department === "it");
const powertrainMembers = members.filter(
	(member) => member.department === "powertrain"
);
const graphicsMembers = members.filter(
	(member) => member.department === "graphics"
);
const electronicsMembers = members.filter(
	(member) => member.department === "electronics"
);
const businessAndCostMembers = members.filter(
	(member) => member.department === "business" || member.department === "cost"
);
const advisorsMembers = members.filter(
	(member) => member.department === "advisors"
);
const logisticsMembers = members.filter(
	(member) => member.department === "logistics"
);

const metadata = {
	title: "Team • Apex Corse",
	description: "Meet the team behind Apex Corse",
};
---

<Layout title={metadata.title} description={metadata.description}>
	<TextDisplay text="The Team" image={team.src} />
	<DepartmentSection
		department="board"
		title="Board"
		members={boardMembers}
		description="Composed of young students driven by determination and passion, the Board of APEX Corse coordinates the activities of the various operational divisions and leads the team toward achieving its goals. It includes the Team Leader, Technical Director, Managing Director, and all Division Managers."
	/>

	<DepartmentSection
		department="chassis"
		title="Chassis"
		members={chassisMembers}
		description="The Chassis Department is responsible for the design and construction of the single-seater’s body. Its main tasks include material selection, structural frame analysis, and design optimization, with the aim of achieving a safe and high-performing solution."
	/>
	<DepartmentSection
		department="aerodynamics"
		title="Aerodynamics"
		members={aerodynamicsMembers}
		description="The Aerodynamics Department designs and develops the car’s aerodynamic package, working in close synergy with the Chassis Department. Each component is integrated into the overall design to optimize airflow efficiency."
	/>
	<DepartmentSection
		department="it"
		title="IT"
		members={itMembers}
		description="The IT Department develops software for data acquisition and analysis, manages internal IT systems, and provides technical support to the other operational divisions, contributing to the continuous improvement of the team’s performance."
	/>
	<DepartmentSection
		department="powertrain"
		title="Powertrain"
		members={powertrainMembers}
		description="The Powertrain Department is in charge of developing the propulsion system. It designs, builds, and optimizes all the key components that make up the heart of the single-seater."
	/>
	<DepartmentSection
		department="electronics"
		title="Electronics"
		members={electronicsMembers}
		description="The Electronics Department handles the design and implementation of all electronic systems of the car, focusing on electrical system management, data acquisition, and control and safety devices."
	/>
	<DepartmentSection
		department="graphics"
		title="Graphics"
		members={graphicsMembers}
		description="The Graphics & Media Department manages the team’s visual identity. It creates digital content, graphic materials, and communication across social channels, showcasing the project and enhancing the image of APEX Corse."
	/>
	<DepartmentSection
		department="business"
		title="Business & Cost"
		members={businessAndCostMembers}
		description="The Business & Cost Department manages sponsorships and financial planning. Its work ensures the economic resources necessary for the design and construction of the single-seater."
	/>
	<DepartmentSection
		department="logistics"
		title="Logistics"
		members={logisticsMembers}
		description="The Logistics Department organizes and coordinates the team’s operations, ensuring that resources, materials, and schedules are efficiently managed for the success of the project."
	/>
	<DepartmentSection
		department="advisors"
		title="Advisors"
		members={advisorsMembers}
		description="The Faculty Advisors are academic figures who provide their expertise to the team. While not part of its operational activities, their support represents a valuable resource for the technical and strategic growth of the project."
	/>
	<Footer />
</Layout>
